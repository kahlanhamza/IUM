{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "IUM",
  "mainBinaryName": "IUM",
  "version": "0.2.1",
  "identifier": "app.ium.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "IUM — Internet Upload Manager",
        "width": 1080,
        "height": 720,
        "minWidth": 720,
        "minHeight": 480,
        "visible": false,
        "transparent": true
      },
      {
        "label": "splash",
        "url": "index.html#/launch",
        "title": "IUM",
        "width": 380,
        "height": 440,
        "center": true,
        "decorations": false,
        "resizable": false,
        "skipTaskbar": true,
        "alwaysOnTop": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "category": "Productivity",
    "copyright": "© 2026 the IUM community — MIT",
    "shortDescription": "Reliability-engineered uploads",
    "longDescription": "IUM applies download-manager reliability engineering to uploads: a dynamic chunk pool, a crash-safe SQLite WAL journal, counted retries with backoff, slow-connection eviction, and verify-before-declare — with honest badges for every destination.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "English"
        ]
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/kahlanhamza/IUM/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM2QjY1OUU5RUI2RjMxMkUKUldRdU1XL3I2Vm0yTmdtYUx3TlFQTUFzL1hRV3N5eWhacTBIZkRYb2dUSnNQTjB2UUZmelkySXEK",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
