# --- secrets: never commit ---
.secrets/

# --- user-facing delivery channel (repo holds docs/ + rea-lab/out/ instead) ---
upload/
download/

# --- acquired binaries & local tooling (large / not redistributable) ---
rea-lab/targets/
rea-lab/bin/
rea-lab/pylib/

# --- sandbox infra (not part of IUM) ---
skills/
.env
agent-ctx/

# --- ephemera ---
node_modules/
target/
ium-app/dist/
__pycache__/
*.pyc
*.log
tool-results/

# --- local rust toolchain (sandbox-persistent, not part of the repo) ---
.toolchain/

# --- gate.sh shared build cache for committed-tree worktrees ---
.gate-target/

# --- local S3 test server (Garage rehearsal harness, not part of the repo) ---
.garage-local/
.weed-local/
.tus-local/

# past-session RE tooling (never project files)
/tools/
# vendor binaries are inputs/throwaways — string dumps are the evidence (ADR-009)
rea-lab/**/*.exe
